# =============================================================================
# AKP — Agroudan Kisan Pragati
# File: Ai/.env
# Purpose: AI module environment variables. Loaded by config.py and
#          knowledge_service.py at startup.
# =============================================================================

# MongoDB (mirrors backend/.env)
MONGO_URI=mongodb://localhost:27017/kisan-pragati
MONGO_DB_NAME=kisan-pragati
MONGO_COLLECTION=diseaseknowledgebases
MONGO_TIMEOUT_MS=5000

# YOLO Inference Server
YOLO_PORT=8000
YOLO_HOST=0.0.0.0

# Pragati AI Bridge
PAC_BRIDGE_PORT=8001
PAC_BRIDGE_HOST=0.0.0.0

# CORS — comma-separated allowed origins (use * for development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:3001

# Logging
AKP_LOG_LEVEL=INFO
PAC_LOG_LEVEL=INFO
IE_LOG_LEVEL=INFO
KR_LOG_LEVEL=INFO
STT_LOG_LEVEL=INFO

# Hardware
# AKP_DEVICE=cpu   # Uncomment to force CPU

# Training overrides (optional)
# AKP_EPOCHS=50
# AKP_BATCH_SIZE=16
# AKP_LR=0.001

# STT
STT_DEFAULT_MODEL=base
STT_COMPUTE_TYPE=int8

# Intent Engine
IE_CONFIDENCE_THRESHOLD=0.30

# Knowledge Router
KR_CONFIDENCE_THRESHOLD=0.30
KR_FALLBACK_MODULE=general_ai

# Cache
PAC_CACHE_SIZE=256
PAC_CACHE_TTL_S=300

# Session
PAC_SESSION_TIMEOUT=1800
PAC_STM_LIMIT=20
PAC_LTM_LIMIT=200
