# Voice Guide AI — Environment Variables Template
# Copy this file to .env and fill in values

# Application
VOICE_GUIDE_ENV=production
VOICE_GUIDE_DEBUG=false
VOICE_GUIDE_LOG_LEVEL=INFO

# Language
VOICE_GUIDE_DEFAULT_LANGUAGE=hi

# Dialogue behaviour
VOICE_GUIDE_MAX_HISTORY=500
VOICE_GUIDE_MAX_REPLAY=10
VOICE_GUIDE_OFFLINE=false

# Bridge server
VOICE_GUIDE_BRIDGE_PORT=8002
VOICE_GUIDE_BRIDGE_HOST=0.0.0.0
VOICE_GUIDE_CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:3001

# Backend integration
BACKEND_API_URL=http://localhost:5000

# Optional path overrides
# VOICE_GUIDE_DIALOGUES_DIR=
# VOICE_GUIDE_TRANSLATIONS_DIR=
# VOICE_GUIDE_LOGS_DIR=
